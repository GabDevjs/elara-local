{
  "name": "@elara/schemas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contrato compartilhado entre daemon e TypeScript: tipos gerados do Rust + validação zod.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
