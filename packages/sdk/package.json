{
  "name": "@elara/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cliente tipado do daemon agentd sobre Unix socket, com validação zod na fronteira.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "vitest run"
  },
  "dependencies": {
    "@elara/schemas": "workspace:*",
    "@elara/shared": "workspace:*",
    "undici": "8.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
