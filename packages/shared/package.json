{
  "name": "@elara/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Utilidades comuns: logging estruturado, caminhos XDG e erros tipados.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
